# ==================================
# Backend Environment Configuration
# ==================================
# Copy this file to .env and update with your values

# ===================
# ENVIRONMENT
# ===================
ENV=development
PORT=8080
GIN_MODE=debug

# ===================
# DATABASE (PostgreSQL)
# ===================
DB_HOST=localhost
DB_PORT=5432
# Matches docker-compose.yml (POSTGRES_USER=labuda, POSTGRES_DB=labuda).
# If you use a custom Postgres setup, change these to match your local credentials.
DB_USER=labuda
DB_PASSWORD=labuda123
DB_NAME=labuda
DB_SSLMODE=disable

# ===================
# TEST DATABASE
# ===================
# Test database name (must be different from DB_NAME)
DB_TEST_NAME=labuda_test
# Optional: Override test DB connection (defaults to main DB settings if not set)
# DB_TEST_HOST=localhost
# DB_TEST_PORT=5432
# DB_TEST_USER=labuda
# DB_TEST_PASSWORD=labuda123
# DB_TEST_SSLMODE=disable

# ===================
# REDIS
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================
# FIREBASE (REQUIRED)
# ===================
# Firebase Project ID from Firebase Console
FIREBASE_PROJECT_ID=labuda-79de2

# Path to service account JSON file (relative to backend folder)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./configs/firebase-service-account.json

# ===================
# DEVELOPMENT MODE
# ===================
# WARNING: Set to false for production!
DEV_AUTO_APPROVE_VERIFICATION=false
DEV_SKIP_PAYMENT_GATEWAY=false
DEV_MOCK_FIREBASE_AUTH=false

# ===================
# PAYMENT GATEWAY (Midtrans)
# ===================
# Backend-only secret. Never mirror this into mobile env files.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_NOTIFICATION_URL=

# ===================
# MIDTRANS IRIS (Payout/Disbursement)
# ===================
# Iris is a SEPARATE Midtrans product with separate credentials.
# Mid-server-* keys are rejected by Iris (HTTP 401 — proven TASK 58).
# Obtain from: Midtrans Iris dashboard (app.sandbox.midtrans.com/iris)
# Required when PAYOUT_GATEWAY_PROVIDER=midtrans_payout
MIDTRANS_IRIS_OPERATOR_KEY=
MIDTRANS_IRIS_APPROVER_KEY=
PAYOUT_WEBHOOK_URL=

# --- Payout completion-loop safety (PASS_18S) ---
# PayoutWorker submits real disbursement requests to the gateway. Once
# submitted, the ONLY way a payout reaches a confirmed terminal state is via
# a verified webhook callback (PAYOUT_SECRET_KEY below) — the reconciliation
# worker is read-only/reporting-only and cannot resolve a stuck payout.
# If PAYOUT_ENABLE_WORKER=true with PAYOUT_SECRET_KEY unset, staging/production
# will refuse to boot (development degrades readiness instead, loudly logged).
PAYOUT_ENABLE_WORKER=false
# HMAC-SHA256 secret Midtrans Iris signs payout webhook callbacks with.
# Required for PayoutWorker to have a completion path outside development.
# Never commit a real value here.
PAYOUT_SECRET_KEY=
# midtrans_payout requires an explicit PAYOUT_GATEWAY_PROVIDER outside
# development — it is never silently defaulted in staging/production.
PAYOUT_GATEWAY_PROVIDER=sandbox
# Midtrans-Iris-specific axis (sandbox|production) — separate from ENV above.
PAYOUT_ENVIRONMENT=sandbox
PAYOUT_ENABLE_PRODUCTION=false
# Read-only/reporting worker only (does not confirm or transition payout
# state). Does NOT count as a completion path — do not rely on this alone.
PAYOUT_ENABLE_RECONCILIATION=false

# ===================
# AWS (Optional - for S3 uploads)
# ===================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=labuda-uploads
S3_BUCKET_REGION=ap-southeast-1

# ===================
# CORS
# ===================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400

# ===================
# RATE LIMITING
# ===================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST=200

# ===================
# LOGGING
# ===================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ===================
# APP INFO
# ===================
APP_NAME=Labuda Backend
APP_VERSION=0.1.0
FRONTEND_URL=http://localhost:3000

# ===================
# MIGRATION
# ===================
# Deprecated compatibility flags only. The current runtime does NOT auto-run
# migrations at startup; run `go run ./cmd/migrate` from backend/ first.
RUN_MIGRATIONS_ON_STARTUP=false
AUTO_MIGRATE=false

# ===================
# GOVERNANCE EVALUATOR (Batch B6 — /search/content enforce promotion)
# ===================
# /search/content evaluator operating mode. Valid values:
#   shadow  — fire-and-forget telemetry only; response wire shape unchanged.
#   enforce — synchronous filter (DENY → drop) + lifecycle coarsening
#             (TOMBSTONE → "removed", REDACT → "unavailable") before
#             serialization. Mobile ContentCard lifecycle adoption shipped
#             in B5.2, so the discovery UX renders these states correctly.
# Rollback: change to `shadow` and restart — same env-var flip, no code
# change, no schema change, no migration. Unset / empty / invalid values
# fall safe to shadow via NormalizeSearchContentAdapterMode.
SEARCH_CONTENT_EVALUATOR_MODE=enforce

# ===================
# GOVERNANCE EVALUATOR — SHADOW MODE (F1-W3 rollout toggles)
# ===================
# Enable shadow (fire-and-forget) evaluator runs for feed and content-detail
# endpoints. Default OFF — enables parallel evaluation without changing wire shape.
# Toggle on independently to observe telemetry before promoting to enforce.
# Rollback: set to false and restart — no schema change, no migration.
EVALUATOR_SHADOW_FEED_ENABLED=false
EVALUATOR_SHADOW_CONTENT_DETAIL_ENABLED=false

# CHAT-5: Mute governance for chat notification delivery.
# Shadow-first rollout — set to false (or omit) during observability phase.
#   false (default) — shadow mode: evaluate mute, emit divergence telemetry, always deliver.
#   true            — enforce mode: suppress both in-app and push for muted sender.
# Scope: chat_message notification type only. REST and WebSocket are NOT affected.
# Rollback: set to false and restart — single-knob flip, no schema change.
MUTE_CHAT_NOTIFICATION_ENFORCE=false

# ===================
# WORKER GATES (Z4 — P1 operational workers)
# ===================
# All default ON. Set to true to disable. Rollback: set to false and restart.
#
# Archives outbox events with status='succeeded' older than OUTBOX_RETENTION_DAYS (default 30).
# MUST stay ON: outbox table has no other deletion mechanism — unbounded growth otherwise.
DISABLE_OUTBOX_ARCHIVAL_WORKER=false

# Auto-cancels paid orders where seller misses ready_to_ship_by + 2-day grace period.
# Refunds buyer via canonical gateway path (InitiateGatewayRefundForOrder).
# MUST stay ON: without this, overdue orders freeze buyer escrow indefinitely.
DISABLE_ORDER_OVERDUE_CANCEL_WORKER=false

# Sends tiered overdue notifications to seller (all tiers) and buyer (tier 2+).
# Tier 1: Day 0 overdue (seller only). Tier 2: Day 3 (seller+buyer). Tier 3: Day 7+ (seller+buyer+support CTA).
# Dedup via order_overdue_reminders table (migration 000168). Read-only: does NOT cancel or refund.
DISABLE_ORDER_OVERDUE_REMINDER_WORKER=false

# Detects and recovers subscription payments with no matching seller_subscription row.
# Calls ProcessSuccessfulPayment idempotently to repair orphaned records.
# MUST stay ON: sellers who paid but got no subscription remain expired permanently.
DISABLE_SUBSCRIPTION_RECONCILIATION_WORKER=false

# Read-only monitor that alerts on withdrawals stuck in PROCESSING/REQUESTED > 24h.
# Does NOT mutate ledger or withdrawal state. Logs CRITICAL and counts for ops visibility.
# Recommended ON: ops are blind to stuck payouts without this monitor.
DISABLE_WITHDRAWAL_MONITORING_WORKER=false

# Outbox archival tuning (used by OUTBOX_ARCHIVAL_WORKER above):
OUTBOX_RETENTION_DAYS=30
OUTBOX_ARCHIVE_BATCH_SIZE=500

# ===================
# WORKER GATES (Z5/Z6 — reliability workers)
# ===================
# All default ON. Set to true to disable.

# Invalidates ratings for refunded/cancelled orders (eventual-consistency safety net).
# Does NOT mutate ledger. Primary invalidation is in OrderCompletionService; this is the sweep.
# Safe to disable temporarily; ratings may lag refund state until re-enabled.
DISABLE_RATING_INVALIDATION_WORKER=false

# Retries failed FCM push notifications with exponential backoff (1m → 8h, max 10 attempts/24h).
# Disable only for debugging; disabling silently drops failed push retries.
DISABLE_PUSH_RETRY_WORKER=false

# Deletes notification_delivery_log rows older than 30 days and expired push_retry_queue entries.
# Safe to disable temporarily; tables will grow unbounded without cleanup.
DISABLE_NOTIFICATION_CLEANUP_WORKER=false

# Deletes idempotency_records older than 30 days (API response cache for retry dedup).
# Does NOT touch ledger_transactions, refunds, withdrawals, or outbox idempotency keys.
# Safe to disable temporarily; idempotency_records table will grow unbounded without cleanup.
DISABLE_IDEMPOTENCY_CLEANUP_WORKER=false

# Polls 10 detection rules every 5 minutes, creates operator alerts in system_alerts.
# All rules are read-only (no domain mutations). Dedup prevents alert spam.
# Rules: payment_stuck, payment_failure_spike, dispute_spike, seller_risk,
#         coins_anomaly, withdrawal_anomaly, stale_dispute_freeze,
#         subscription_orphaned, subscription_conversion_rate, subscription_lifecycle.
DISABLE_ALERT_DETECTION_WORKER=false

# ===================
# WORKER GATES (auction / subscription / payment)
# ===================

# Expires active seller subscriptions past their expiry date (active→expired lifecycle).
# Runs hourly. MUST stay ON: without this, expired subscriptions remain 'active' indefinitely.
DISABLE_SELLER_SUBSCRIPTION_EXPIRY_WORKER=false

# Activates scheduled auctions whose start_at time has arrived (scheduled→active).
# Polls every 30s, batch 50. Re-verifies seller subscription at activation time.
DISABLE_AUCTION_START_WORKER=false

# Closes auctions whose end_time has passed (transitions active→ended/sold).
# Polls every 30s, batch 50. Winner claim flow handles trade creation.
DISABLE_AUCTION_END_WORKER=false

# Enforces the canonical auction settlement shipping deadline (waiting_settlement
# with end_at+24h passed and shipping unresolved → violation/restriction + DRAFT).
# Polls every 5min, batch 50. Default ON.
DISABLE_AUCTION_SETTLEMENT_WORKER=false

# ===================
# WORKER GATES (projection)
# ===================

# Builds read-side projections from outbox events (order_summaries table).
# Schema is ready (migrations 149-150). Default OFF pending operator smoke test.
# Enable after verifying projection_tracker and account_balances tables are seeded.
DISABLE_PROJECTION_WORKER=true

# ===================
# WORKER GATES (escrow integrity — money safety detector, PASS_18R)
# ===================

# Periodic escrow reconciliation: checks that order escrow_amount matches wallet held_balance.
# Read-only detection layer (no mutations). This is a money-safety detector and
# MUST NOT be silently dormant — it defaults to ENABLED (in shadow mode).
# Set to true only to explicitly opt out. Wired in dependencies.go behind
# workerEnabled gate; current activation state is also surfaced at runtime via
# GET /health/ready (see "worker_safety" in the response body).
DISABLE_ESCROW_INTEGRITY_WORKER=false

# Check interval in minutes. Default 15. Minimum 1.
ESCROW_INTEGRITY_INTERVAL_MINUTES=15

# Shadow mode: log mismatches but suppress alert creation in the checker.
# Default true (safer staged activation). Set to false only after validating
# shadow logs show no false positives, to promote to live alerts.
ESCROW_INTEGRITY_SHADOW_MODE=true

# WORKER GATES (total money invariant — money safety detector, PASS_18R)
# ===================

# Periodic total money invariant check: verifies SUM(financial_accounts.balance) == seed.
# Read-only detection layer (no mutations). This is a money-safety detector and
# MUST NOT be silently dormant — it defaults to ENABLED (in shadow mode).
# Set to true only to explicitly opt out. Wired in dependencies.go behind
# workerEnabled gate; current activation state is also surfaced at runtime via
# GET /health/ready (see "worker_safety" in the response body).
DISABLE_TOTAL_MONEY_INVARIANT_WORKER=false

# Check interval in minutes. Default 15. Minimum 1.
TOTAL_MONEY_INVARIANT_INTERVAL_MINUTES=15

# Shadow mode: log violations but suppress alert creation in the checker.
# Default true (safer staged activation). Set to false only after validating
# shadow logs show no false positives, to promote to live alerts.
TOTAL_MONEY_INVARIANT_SHADOW_MODE=true

# ===================
# SELLER METRICS WORKER (measurement only)
# ===================
# Generates monthly seller performance snapshots (seller_monthly_metrics table).
# Writes: seller_monthly_metrics ONLY (no tier/profile/subscription/ledger mutation).
# Idempotent per (seller_id, year, month) via UNIQUE constraint.
# Runs daily, snapshots previous month. Default ON.
DISABLE_SELLER_METRICS_WORKER=false

# ===================
# DANGEROUS DORMANT WORKERS — require explicit ACK to enable
# ===================
# These workers mutate money or perform mass operations. Two-key activation required:
# 1. Set DISABLE_*=false
# 2. Set ACK_DANGEROUS_*=true
# Both must be set. Missing either keeps the worker dormant.

# Expires orphan pending_payment orders where buyer never initiated payment.
# Complementary to PAYMENT_EXPIRY_WORKER (which handles orders WITH payment rows).
# Safe: no gateway calls, only stock restore + order status transition.
DISABLE_ORDER_PAYMENT_TIMEOUT_WORKER=false

# Triggers gateway refund for orders whose payment_expires_at has passed.
# WARNING: Irreversible gateway calls. Only enable after confirming payment gateway sandbox.
DISABLE_PAYMENT_EXPIRY_WORKER=false
ACK_DANGEROUS_PAYMENT_EXPIRY_WORKER=true

# Recovers webhooks that arrive BEFORE their payment row is committed to the
# DB (a race condition), not late webhooks for an already-expired payment —
# GetOrphanedWebhookEvents only scans status='orphaned' rows, which is set
# when payment lookup fails entirely; an expired payment is always found, so
# it never enters this worker's queue (PASS_18T audit). Left dormant here;
# do not enable without a dedicated fix/verification pass for its own race
# condition. The late-webhook-after-expiry gap is now handled inline in the
# webhook handler itself (captured_after_expiry + alert), not by this worker.
DISABLE_ORPHAN_WEBHOOK_RECOVERY_WORKER=true

# Processes moderation enforcement events (content/comment soft-delete, listing withdrawal,
# user suspension/restoration). Zero money risk — no escrow/ledger/refund mutations.
# Auction moderation is PARKED (consumed as no-op) pending moderation-specific cancel authority.
# Default ON. Set to true to disable.
DISABLE_MODERATION_EVENT_HANDLER=false

# Triggers mass refunds for all open orders when a seller is banned.
# WARNING: Irreversible. Cascades across all affected buyer orders.
DISABLE_USER_BAN_EVENT_HANDLER=true
ACK_DANGEROUS_USER_BAN_EVENT_HANDLER=false

# Enforces dispute timeout policy to prevent escrow deadlock.
# After 3 days: marks dispute as overdue. After 14 days: escalates for admin review.
# SAFE: Zero money mutation. Only writes is_overdue flag + outbox event.
# Default ON. Set to true to disable.
DISABLE_DISPUTE_TIMEOUT_WORKER=false

# ─── GATEWAY REFUND ─────────────────────────────────────────────────────────
# Gates the admin-manual gateway refund trigger endpoint only:
#   POST /admin/refunds/:refund_id/gateway/initiate
#   Capability: finance.refund.gateway.initiate
#
# The full refund pipeline (webhook ack → ledger reversal → escrow flip →
# order status sync → coins.refund_required) runs UNCONDITIONALLY for all
# system-initiated paths (dispute resolution, timeout cancellation, expiry).
# Phase 2B is fully wired; enabling this flag adds only the admin-manual
# trigger, not new financial mutations.
#
# Default false (production safe). Enable in staging once admin refund UX is
# verified via corpus_driver scenario-d11 or manual Midtrans sandbox test.
ENABLE_GATEWAY_REFUND_PHASE2=false
