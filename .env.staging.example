# Phase 5.4: Staging Environment Variables
# Copy this file to .env.staging and fill in the actual values
# DO NOT commit .env.staging to version control

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=labuda
POSTGRES_PASSWORD=CHANGE_ME_THIS_IS_NOT_SECURE
POSTGRES_DB=labuda_staging

# =============================================================================
# MIDTRANS (SANDBOX)
# =============================================================================
# Get these from Midtrans Dashboard: https://dashboard.sandbox.midtrans.com/
MIDTRANS_SANDBOX_SERVER_KEY=SB-Mid-server-CHANGE_ME
MIDTRANS_SANDBOX_CLIENT_KEY=SB-Mid-client-CHANGE_ME
MIDTRANS_NOTIFICATION_URL=https://staging.labuda.com/api/v1/payments/webhook

# =============================================================================
# FIREBASE
# =============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=https://staging.labuda.com,http://localhost:3000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
