  "articleHowToPay": "How to pay for my order?",
  "@articleHowToPay": {
    "description": "Article: How to pay"
  },

  "articleHowToPayContent": "To pay for your order:\n\n1. Go to your order from the Orders screen\n2. Tap the 'Pay Now' button\n3. Select your payment method (GoPay, Bank Transfer, etc.)\n4. Follow the instructions to complete payment\n5. Your payment will be confirmed within 24 hours\n\nIf payment fails, you can retry from the order screen.",
  "@articleHowToPayContent": {
    "description": "Article: How to pay content"
  },

  "articleTrackOrder": "How to track my order?",
  "@articleTrackOrder": {
    "description": "Article: Track order"
  },

  "articleTrackOrderContent": "To track your order:\n\n1. Go to 'My Orders' from the profile menu\n2. Tap on the order you want to track\n3. You'll see the current status and tracking information\n\nOrder statuses:\n- Pending: Waiting for payment\n- Processing: Seller is preparing your order\n- Shipped: Order is on the way\n- Delivered: Order has arrived\n- Completed: Order is finished",
  "@articleTrackOrderContent": {
    "description": "Article: Track order content"
  },

  "articleRequestRefund": "How to request a refund?",
  "@articleRequestRefund": {
    "description": "Article: Request refund"
  },

  "articleRequestRefundContent": "To request a refund:\n\n1. Open the order details\n2. Tap 'Request Refund'\n3. Select a reason and describe the issue\n4. Upload unboxing video as proof (required)\n5. Submit your request\n\nThe seller will review your request. If rejected, you can escalate to admin for final decision.",
  "@articleRequestRefundContent": {
    "description": "Article: Request refund content"
  },

  "articleBecomeSeller": "How to become a seller?",
  "@articleBecomeSeller": {
    "description": "Article: Become seller"
  },

  "articleBecomeSellerContent": "To become a seller on LABUDA:\n\n1. Go to Settings → Upgrade to Seller\n2. Choose your plan (Basic or Pro)\n3. Fill in your business information\n4. Complete payment for the subscription\n5. Wait for verification approval\n\nOnce approved, you can start listing your koi for sale!",
  "@articleBecomeSellerContent": {
    "description": "Article: Become seller content"
  },

  "articleCancelOrder": "How to cancel an order?",
  "@articleCancelOrder": {
    "description": "Article: Cancel order"
  },

  "articleCancelOrderContent": "Order cancellation depends on the status:\n\n- Pending payment: Auto-cancelled if not paid within 24 hours\n- Processing: Contact seller to cancel\n- Shipped: Cannot cancel, use refund process instead\n\nTo request cancellation, tap the order and select 'Contact Seller' to discuss.",
  "@articleCancelOrderContent": {
    "description": "Article: Cancel order content"
  },

  "articleConfirmDelivery": "How to complete an order?",
  "@articleConfirmDelivery": {
    "description": "Article: Complete order"
  },

  "articleConfirmDeliveryContent": "To complete your order after receiving items:\n\n1. Open the order details\n2. Tap 'Terima Barang' button\n3. Confirm that items match your order\n\nIf you don't confirm within 5 days of shipment, the order will auto-complete.",
  "@articleConfirmDeliveryContent": {
    "description": "Article: Complete order content"
  },

  "articlePaymentFailed": "Payment failed, what to do?",
  "@articlePaymentFailed": {
    "description": "Article: Payment failed"
  },

  "articlePaymentFailedContent": "If your payment fails:\n\n1. Check your payment method balance\n2. Try a different payment method\n3. Ensure you have stable internet connection\n4. Retry payment from the order screen\n\nIf the issue persists, contact support with your order number.",
  "@articlePaymentFailedContent": {
    "description": "Article: Payment failed content"
  },

  "articleRefundTime": "How long does refund take?",
  "@articleRefundTime": {
    "description": "Article: Refund time"
  },

  "articleRefundTimeContent": "Refund processing time:\n\n1. Seller review: 1-3 days\n2. If approved: 3-7 business days for funds to return\n\nThe exact time depends on your payment method. GoPay refunds are usually faster than bank transfers.",
  "@articleRefundTimeContent": {
    "description": "Article: Refund time content"
  },

  "articleCreateListing": "How to create a listing?",
  "@articleCreateListing": {
    "description": "Article: Create listing"
  },

  "articleCreateListingContent": "To create a new listing:\n\n1. Tap the + button on the home screen\n2. Select 'Listing'\n3. Add photos of your koi (multiple angles recommended)\n4. Fill in details (variety, size, price, location)\n5. Write a description\n6. Publish your listing\n\nYour listing will be visible to buyers immediately!",
  "@articleCreateListingContent": {
    "description": "Article: Create listing content"
  },

  "articleShippingSetup": "How to set up shipping?",
  "@articleShippingSetup": {
    "description": "Article: Shipping setup"
  },

  "articleShippingSetupContent": "To set up shipping:\n\n1. Go to Seller Dashboard\n2. Select a shipping partner (available options)\n3. Set your shipping zones and rates\n4. Add packaging instructions\n\nAlways use proper packaging with oxygen for live koi shipping!",
  "@articleShippingSetupContent": {
    "description": "Article: Shipping setup content"
  },

  "articleEditProfile": "How to edit my profile?",
  "@articleEditProfile": {
    "description": "Article: Edit profile"
  },

  "articleEditProfileContent": "To edit your profile:\n\n1. Go to your profile screen\n2. Tap the edit icon\n3. Update your information:\n   - Profile photo\n   - Display name\n   - Bio\n   - Location\n4. Tap 'Save' to apply changes",
  "@articleEditProfileContent": {
    "description": "Article: Edit profile content"
  },

