[TEMPLATE]
# Environment Variables
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MIDTRANS_MERCHANT_ID=your-midtrans-merchant-id-here
MIDTRANS_CLIENT_KEY=your-midtrans-client-key-here

# Client-safe values only. Midtrans server key must never be placed in the mobile app or any client-side env file.

# Backend base URL (optional, STAGE 3B).
# Dev default is localhost:8080 for all platforms.
# Physical Android devices require: adb reverse tcp:8080 tcp:8080
# For a custom host, pass the override at build/run time — no source edit needed:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.50:8080/api/v1
#   flutter run --dart-define=API_WS_URL=ws://192.168.1.50:8080/api/v1/ws
