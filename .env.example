# ============================================
# ENVIRONMENT VARIABLES - LABUDA PROJECT
# ============================================
# Copy file ini ke .env dan sesuaikan nilainya

# ===================
# DATABASE (PostgreSQL di Docker)
# ===================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=labuda

# ===================
# REDIS (Docker)
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================
# API SERVER (Go Backend)
# ===================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ===================
# FIREBASE
# ===================
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./configs/firebase-service-account.json

# ===================
# FLUTTER / FRONTEND
# ===================
API_BASE_URL=http://localhost:8080
WS_BASE_URL=ws://localhost:8080

# ===================
# PAYMENT GATEWAY (Midtrans)
# ===================
# Client-safe Midtrans values only. Never place a Midtrans server key in mobile or frontend env files.
MIDTRANS_MERCHANT_ID=your-midtrans-merchant-id-here
MIDTRANS_CLIENT_KEY=your-midtrans-client-key-here

# ===================
# GOOGLE MAPS API
# ===================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===================
# JWT / AUTH
# ===================
JWT_SECRET=labuda-secret-key-change-in-production
JWT_EXPIRATION=24h

# ===================
# AWS (Optional - S3 Upload)
# ===================
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===================
# ENVIRONMENT
# ===================
ENV=development
DEBUG=true
LOG_LEVEL=debug
